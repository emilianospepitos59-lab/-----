'use strict';

/* ─────────────────────────────────────────────
   CUSTOM CURSOR
───────────────────────────────────────────── */
(function initCursor() {
  const cursor = document.getElementById('cursor');
  if (!cursor) return;

  let cx = -100, cy = -100;
  let raf;

  function moveCursor(e) {
    cx = e.clientX;
    cy = e.clientY;
    if (!raf) {
      raf = requestAnimationFrame(() => {
        cursor.style.left = cx + 'px';
        cursor.style.top  = cy + 'px';
        raf = null;
      });
    }
  }

  document.addEventListener('mousemove', moveCursor);
  document.addEventListener('mouseenter', () => document.body.classList.add('cursor-active'));
  document.addEventListener('mouseleave', () => document.body.classList.remove('cursor-active'));
})();


/* ─────────────────────────────────────────────
   REAL-TIME CLOCK
───────────────────────────────────────────── */
(function initClock() {
  const el = document.getElementById('clock');
  if (!el) return;

  function tick() {
    const d = new Date();
    const h = String(d.getHours()).padStart(2, '0');
    const m = String(d.getMinutes()).padStart(2, '0');
    const s = String(d.getSeconds()).padStart(2, '0');
    el.textContent = h + ':' + m + ':' + s;
  }
  tick();
  setInterval(tick, 1000);
})();


/* ─────────────────────────────────────────────
   HERO DATE STAMP
───────────────────────────────────────────── */
(function initHeroDate() {
  const el = document.getElementById('heroDate');
  if (!el) return;
  const d = new Date();
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  el.textContent = y + '.' + m + '.' + day;
})();


/* ─────────────────────────────────────────────
   TYPEWRITER HELPER
───────────────────────────────────────────── */
function typeIn(el, text, speed, delay) {
  return new Promise(function(resolve) {
    setTimeout(function() {
      var i = 0;
      var iv = setInterval(function() {
        el.textContent += text[i];
        i++;
        if (i >= text.length) {
          clearInterval(iv);
          resolve();
        }
      }, speed);
    }, delay || 0);
  });
}

function pause(ms) {
  return new Promise(function(r) { setTimeout(r, ms); });
}


/* ─────────────────────────────────────────────
   HERO TYPE SEQUENCE
───────────────────────────────────────────── */
(function initHeroType() {
  var subtitleEl    = document.getElementById('heroSubtitle');
  var terminalEl    = document.getElementById('terminalText');
  if (!subtitleEl || !terminalEl) return;

  var subtitleText = 'Особистий архів дивних ідей та випадкових проєктів';
  var terminalSteps = [
    'ініціалізація системи...',
    'завантаження файлів...',
    'перевірка доступу...',
    'доступ дозволено.',
  ];

  async function run() {
    await typeIn(subtitleEl, subtitleText, 32, 400);
    await pause(300);

    for (var i = 0; i < terminalSteps.length; i++) {
      await typeIn(terminalEl, terminalSteps[i], 28, 150);
      await pause(550);
      if (i < terminalSteps.length - 1) {
        terminalEl.textContent = '';
      }
    }
  }
  run();
})();


/* ─────────────────────────────────────────────
   NAVIGATION: SCROLL + ACTIVE STATE
───────────────────────────────────────────── */
(function initNav() {
  var nav         = document.getElementById('nav');
  var navToggle   = document.getElementById('navToggle');
  var navLinks    = document.getElementById('navLinks');
  var allNavLinks = document.querySelectorAll('.nav-link');
  if (!nav) return;

  /* Sticky style on scroll */
  function onScroll() {
    if (window.scrollY > 60) {
      nav.classList.add('scrolled');
    } else {
      nav.classList.remove('scrolled');
    }

    /* Active link tracking */
    var offset = window.scrollY + 110;
    document.querySelectorAll('section[id]').forEach(function(sec) {
      var top    = sec.offsetTop;
      var bottom = top + sec.offsetHeight;
      var id     = sec.getAttribute('id');
      var link   = document.querySelector('.nav-link[data-section="' + id + '"]');
      if (!link) return;
      if (offset >= top && offset < bottom) {
        allNavLinks.forEach(function(l) { l.classList.remove('active'); });
        link.classList.add('active');
      }
    });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  /* Mobile hamburger */
  if (navToggle && navLinks) {
    navToggle.addEventListener('click', function() {
      var open = navLinks.classList.toggle('open');
      navToggle.classList.toggle('open', open);
      navToggle.setAttribute('aria-expanded', String(open));
    });

    /* Close drawer when a link is tapped */
    allNavLinks.forEach(function(link) {
      link.addEventListener('click', function() {
        navLinks.classList.remove('open');
        navToggle.classList.remove('open');
        navToggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
})();


/* ─────────────────────────────────────────────
   OPEN FILE BUTTON → SMOOTH SCROLL TO ABOUT
───────────────────────────────────────────── */
(function initOpenFile() {
  var btn = document.getElementById('openFileBtn');
  if (!btn) return;
  btn.addEventListener('click', function() {
    var target = document.getElementById('about');
    if (target) target.scrollIntoView({ behavior: 'smooth' });
  });
})();


/* ─────────────────────────────────────────────
   INTERSECTION OBSERVER — SCROLL REVEAL
───────────────────────────────────────────── */
(function initReveal() {
  var elements = document.querySelectorAll('.reveal');
  if (!elements.length) return;

  var io = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        io.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -36px 0px' });

  /* Stagger siblings that share a parent */
  var parents = new Set();
  elements.forEach(function(el) {
    if (el.parentElement) parents.add(el.parentElement);
  });

  parents.forEach(function(parent) {
    var kids = parent.querySelectorAll('.reveal');
    kids.forEach(function(kid, i) {
      kid.style.transitionDelay = (i * 75) + 'ms';
    });
  });

  elements.forEach(function(el) { io.observe(el); });
})();


/* ─────────────────────────────────────────────
   CONTACT — SEND SIGNAL
───────────────────────────────────────────── */
(function initContact() {
  var btn      = document.getElementById('sendSignalBtn');
  var feedback = document.getElementById('signalFeedback');
  if (!btn || !feedback) return;

  var steps = [
    '> СИГНАЛ НАДІСЛАНО...',
    '> ЗВ\'ЯЗОК ВСТАНОВЛЕНО.',
    '> ОЧІКУВАННЯ ВІДПОВІДІ...',
    '> ВІДПОВІДЬ: НЕЗАБАРОМ™',
  ];
  var busy = false;

  btn.addEventListener('click', function() {
    if (busy) return;
    busy = true;
    feedback.textContent = '';

    var i = 0;
    function next() {
      if (i >= steps.length) { busy = false; return; }
      feedback.textContent = steps[i];
      i++;
      setTimeout(next, 850);
    }
    next();
  });
})();


/* ─────────────────────────────────────────────
   EASTER EGG — 5 CLICKS ON TITLE
───────────────────────────────────────────── */
(function initEasterEgg() {
  var title   = document.getElementById('heroTitle');
  var modal   = document.getElementById('easterEggModal');
  var closeBtn= document.getElementById('closeModal');
  if (!title || !modal || !closeBtn) return;

  var clicks  = 0;
  var timer   = null;

  function openModal() {
    modal.hidden = false;
    modal.removeAttribute('hidden');

    /* Stagger the log lines */
    var lines = modal.querySelectorAll('.mlog-line');
    lines.forEach(function(line, i) {
      line.classList.remove('visible');
      setTimeout(function() { line.classList.add('visible'); }, 500 + i * 300);
    });
  }

  function closeModal() {
    modal.hidden = true;
  }

  title.addEventListener('click', function() {
    clicks++;

    /* Micro-bounce feedback */
    title.style.transform = 'scale(1.03)';
    setTimeout(function() { title.style.transform = ''; }, 120);

    clearTimeout(timer);
    if (clicks >= 5) {
      clicks = 0;
      openModal();
      return;
    }
    timer = setTimeout(function() { clicks = 0; }, 2800);
  });

  closeBtn.addEventListener('click', closeModal);

  modal.addEventListener('click', function(e) {
    if (e.target === modal) closeModal();
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !modal.hidden) closeModal();
  });
})();


/* ─────────────────────────────────────────────
   OCCASIONAL GLITCH ON SECTION TITLES
───────────────────────────────────────────── */
(function initGlitch() {
  var titles = document.querySelectorAll('.section-title');
  if (!titles.length) return;

  function randomInt(min, max) {
    return Math.floor(min + (max - min) * (
      /* avoid Date.now / Math.random — use a simple LCG seeded once */
      (performance.now() % 1000) / 1000
    ));
  }

  function glitch() {
    var idx   = Math.floor((performance.now() % 100) / 100 * titles.length);
    var title = titles[idx] || titles[0];
    var orig  = title.style.cssText;

    title.style.textShadow = '-2px 0 rgba(139,64,64,.55), 2px 0 rgba(74,100,60,.55)';
    title.style.transform  = 'translateX(2px)';

    setTimeout(function() {
      title.style.textShadow = '';
      title.style.transform  = '';
    }, 90);
  }

  function schedule() {
    /* fire in 5–13 s — deterministic-ish from perf.now */
    var delay = 5000 + (performance.now() % 8000);
    setTimeout(function() { glitch(); schedule(); }, delay);
  }
  schedule();
})();

/* ============================================================
   НЕ-ДУЖЕ-СЕКРЕТНО — Головні стилі
   Fonts: Share Tech Mono (body), VT323 (display headings)
   Palette: near-black, military olive-green, warm off-white
   ============================================================ */

/* ── Fonts ── */
@import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=VT323&family=Courier+Prime:ital,wght@0,400;0,700;1,400&display=swap');

/* ── Design Tokens ── */
:root {
  /* Backgrounds */
  --bg-root:      #070b08;
  --bg-surface:   #0c1009;
  --bg-card:      #10150d;
  --bg-elevated:  #151b12;
  --bg-inset:     #0a0d08;

  /* Borders */
  --bd-faint:     #141c10;
  --bd-subtle:    #1e2a18;
  --bd-normal:    #2a3820;
  --bd-bright:    #3c5030;

  /* Text */
  --tx-ghost:     #2e3d28;
  --tx-dim:       #4a5e40;
  --tx-muted:     #617851;
  --tx-body:      #8aaa76;
  --tx-main:      #bdd1a6;
  --tx-bright:    #d6e8bc;

  /* Accent — military olive-green */
  --ac-dark:      #253518;
  --ac-mid:       #486040;
  --ac-bright:    #79b268;
  --ac-glow:      rgba(121,178,104,.14);

  /* Semantic */
  --red-dim:      #5a2828;
  --red-mid:      #8b3a3a;
  --amber-dim:    #5a4820;
  --amber-mid:    #947830;
  --grey-dim:     #3a4038;

  /* Typography */
  --ff-mono:    'Share Tech Mono', 'Courier Prime', monospace;
  --ff-display: 'VT323', monospace;

  /* Motion */
  --ease-fast:    150ms ease;
  --ease-med:     300ms ease;
  --ease-slow:    550ms ease;

  /* Layout */
  --max-w:        1080px;
  --nav-h-top:    28px;   /* status bar */
  --nav-h-main:   54px;   /* nav bar */
  --nav-total:    82px;
}

/* ── Reset ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
img, svg { display: block; max-width: 100%; }
button { font: inherit; }
a { color: inherit; }
ul, ol { list-style: none; }

body {
  background: var(--bg-root);
  color: var(--tx-main);
  font-family: var(--ff-mono);
  font-size: 1rem;
  line-height: 1.7;
  overflow-x: hidden;
  cursor: none;           /* replaced by custom cursor */
  min-height: 100vh;
}

/* ────────────────────────────────────────────────
   ATMOSPHERIC OVERLAYS
──────────────────────────────────────────────── */
.overlay-vignette,
.overlay-scanlines,
.overlay-noise {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 9000;
}

/* Radial vignette */
.overlay-vignette {
  background: radial-gradient(ellipse at 50% 40%,
    transparent 55%, rgba(0,0,0,.55) 100%);
}

/* Subtle scanlines */
.overlay-scanlines {
  z-index: 9001;
  background: repeating-linear-gradient(
    0deg,
    transparent 0px, transparent 3px,
    rgba(0,0,0,.025) 3px, rgba(0,0,0,.025) 4px
  );
}

/* Animated film grain */
.overlay-noise {
  z-index: 9002;
  opacity: .035;
  width: 300%; height: 300%;
  top: -100%; left: -100%;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  animation: grainShift .45s steps(3) infinite;
}
@keyframes grainShift {
  0%  { transform: translate(0,0); }
  33% { transform: translate(-1.5%,-1%); }
  66% { transform: translate(1%,1.5%); }
  100%{ transform: translate(0,0); }
}

/* ────────────────────────────────────────────────
   CUSTOM CURSOR
──────────────────────────────────────────────── */
.cursor {
  position: fixed;
  width: 22px; height: 22px;
  pointer-events: none;
  z-index: 9999;
  transform: translate(-50%,-50%);
  opacity: 0;
  transition: opacity var(--ease-fast);
}
.cursor::before {
  content: '';
  position: absolute;
  top: 50%; left: 0;
  width: 100%; height: 1px;
  background: var(--ac-bright);
  transform: translateY(-50%);
}
.cursor::after {
  content: '';
  position: absolute;
  left: 50%; top: 0;
  width: 1px; height: 100%;
  background: var(--ac-bright);
  transform: translateX(-50%);
}
body.cursor-active .cursor { opacity: 1; }

/* ────────────────────────────────────────────────
   STATUS BAR
──────────────────────────────────────────────── */
.status-bar {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: var(--nav-h-top);
  background: var(--bg-surface);
  border-bottom: 1px solid var(--bd-faint);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20px;
  font-size: .7rem;
  letter-spacing: .1em;
  color: var(--tx-muted);
  z-index: 1100;
}

.status-online {
  display: flex;
  align-items: center;
  gap: 7px;
  color: var(--ac-bright);
}

.pulse-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--ac-bright);
  animation: dotPulse 2.2s ease-in-out infinite;
}
.pulse-dot--sm {
  width: 5px; height: 5px;
  display: inline-block;
  vertical-align: middle;
}
@keyframes dotPulse {
  0%,100% { opacity: 1; box-shadow: 0 0 6px var(--ac-bright); }
  50%      { opacity: .35; box-shadow: none; }
}

/* ────────────────────────────────────────────────
   NAVIGATION
──────────────────────────────────────────────── */
.nav {
  position: fixed;
  top: var(--nav-h-top);
  left: 0; right: 0;
  height: var(--nav-h-main);
  background: rgba(7,11,8,.95);
  border-bottom: 1px solid var(--bd-normal);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24px;
  z-index: 1099;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  transition: border-color var(--ease-med), background var(--ease-med);
}
.nav.scrolled {
  background: rgba(7,11,8,.98);
  border-bottom-color: var(--bd-bright);
}

.nav-logo {
  font-family: var(--ff-display);
  font-size: 1.45rem;
  letter-spacing: .18em;
  color: var(--ac-bright);
  user-select: none;
}
.bracket { color: var(--tx-muted); }

.nav-links {
  display: flex;
  gap: 2px;
}
.nav-link {
  color: var(--tx-muted);
  text-decoration: none;
  font-size: .71rem;
  letter-spacing: .14em;
  padding: 5px 10px;
  border: 1px solid transparent;
  position: relative;
  transition: color var(--ease-fast), border-color var(--ease-fast);
}
.nav-link::after {
  content: '';
  position: absolute;
  bottom: 2px; left: 10px; right: 10px;
  height: 1px;
  background: var(--ac-bright);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform var(--ease-med);
}
.nav-link:hover,
.nav-link.active {
  color: var(--ac-bright);
  border-color: var(--bd-normal);
}
.nav-link:hover::after,
.nav-link.active::after { transform: scaleX(1); }

/* Hamburger */
.nav-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 6px;
}
.nav-toggle span {
  display: block;
  width: 22px; height: 1px;
  background: var(--tx-muted);
  transition: transform var(--ease-med), opacity var(--ease-med);
}
.nav-toggle.open span:nth-child(1) { transform: rotate(45deg) translate(4px,4px); }
.nav-toggle.open span:nth-child(2) { opacity: 0; }
.nav-toggle.open span:nth-child(3) { transform: rotate(-45deg) translate(4px,-4px); }

/* ────────────────────────────────────────────────
   LAYOUT PRIMITIVES
──────────────────────────────────────────────── */
.section { padding: 96px 0; position: relative; }

.container {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 24px;
}

.section-header { margin-bottom: 52px; }

.section-label {
  display: block;
  font-size: .7rem;
  letter-spacing: .22em;
  color: var(--tx-dim);
  margin-bottom: 8px;
}

.section-title {
  font-family: var(--ff-display);
  font-size: clamp(2rem, 5vw, 2.8rem);
  letter-spacing: .18em;
  color: var(--tx-bright);
  display: inline-block;
  position: relative;
}
.section-title::after {
  content: '';
  position: absolute;
  bottom: -7px; left: 0;
  width: 52px; height: 2px;
  background: var(--ac-mid);
}

/* ────────────────────────────────────────────────
   HERO
──────────────────────────────────────────────── */
.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: var(--nav-total);
  overflow: hidden;
}

.hero-bg-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(var(--bd-faint) 1px, transparent 1px),
    linear-gradient(90deg, var(--bd-faint) 1px, transparent 1px);
  background-size: 44px 44px;
  opacity: .5;
}

.hero-inner {
  position: relative;
  z-index: 1;
  max-width: 780px;
  width: 100%;
  padding: 0 24px;
  text-align: center;
}

/* Tilted classified stamp */
.file-stamp-banner {
  position: absolute;
  top: -28px; right: 16px;
  font-family: var(--ff-display);
  font-size: 1rem;
  letter-spacing: .22em;
  line-height: 1.2;
  color: var(--red-mid);
  border: 2px solid var(--red-mid);
  padding: 4px 10px;
  transform: rotate(9deg);
  opacity: .55;
  pointer-events: none;
}

/* File metadata strip */
.file-meta {
  border: 1px solid var(--bd-normal);
  padding: 10px 16px;
  margin-bottom: 44px;
  background: rgba(12,16,9,.8);
  font-size: .71rem;
  color: var(--tx-muted);
  letter-spacing: .08em;
  text-align: left;
}
.file-meta-row {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  padding: 3px 0;
}
.file-meta-row + .file-meta-row {
  border-top: 1px solid var(--bd-faint);
  padding-top: 6px;
  margin-top: 3px;
}

/* Main title */
.hero-title {
  font-family: var(--ff-display);
  font-size: clamp(2.4rem, 9vw, 5.5rem);
  letter-spacing: .2em;
  color: var(--tx-bright);
  margin-bottom: 18px;
  text-shadow: 0 0 40px var(--ac-glow);
  cursor: pointer;
  user-select: none;
  animation: heroGlitch 9s infinite;
  line-height: 1.1;
}
@keyframes heroGlitch {
  0%,93%,100% {
    text-shadow: 0 0 40px var(--ac-glow);
    transform: translate(0,0);
    clip-path: none;
  }
  94% {
    text-shadow: -2px 0 rgba(139,64,64,.6), 2px 0 rgba(73,100,60,.6);
    transform: translate(2px,0);
    clip-path: polygon(0 25%, 100% 25%, 100% 45%, 0 45%);
  }
  95.5% {
    transform: translate(-2px,1px);
    clip-path: polygon(0 60%, 100% 60%, 100% 75%, 0 75%);
  }
  96.5% {
    transform: translate(0,0);
    clip-path: none;
  }
}

.hero-subtitle {
  font-size: .88rem;
  color: var(--tx-muted);
  letter-spacing: .08em;
  margin-bottom: 28px;
  min-height: 1.5em;
}

.hero-terminal {
  background: var(--bg-surface);
  border: 1px solid var(--bd-normal);
  padding: 12px 16px;
  margin-bottom: 40px;
  text-align: left;
  font-size: .84rem;
  color: var(--ac-bright);
  min-height: 2.8rem;
}
.terminal-prompt { color: var(--tx-dim); }

.cursor-blink {
  animation: blink 1.1s step-end infinite;
  color: var(--ac-bright);
}
@keyframes blink {
  0%,100% { opacity: 1; }
  50%      { opacity: 0; }
}

/* ────────────────────────────────────────────────
   BUTTONS
──────────────────────────────────────────────── */
.btn-primary {
  display: inline-block;
  background: transparent;
  border: 1px solid var(--ac-mid);
  color: var(--ac-bright);
  font-family: var(--ff-mono);
  font-size: .84rem;
  letter-spacing: .22em;
  padding: 14px 38px;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  transition: border-color var(--ease-med), box-shadow var(--ease-med);
}
.btn-primary::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg,
    transparent, rgba(121,178,104,.08), transparent);
  transform: translateX(-100%);
  transition: transform var(--ease-slow);
}
.btn-primary:hover::before { transform: translateX(100%); }
.btn-primary:hover {
  border-color: var(--ac-bright);
  box-shadow: 0 0 22px rgba(121,178,104,.12);
}
.btn-bracket { color: var(--tx-muted); margin: 0 4px; }

/* Signal button */
.btn-signal {
  display: inline-block;
  background: transparent;
  border: 1px solid var(--ac-mid);
  color: var(--ac-bright);
  font-family: var(--ff-mono);
  font-size: .9rem;
  letter-spacing: .26em;
  padding: 16px 52px;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  transition: border-color var(--ease-med), box-shadow var(--ease-med);
}
.signal-ripple {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at center,
    rgba(121,178,104,.12) 0%, transparent 72%);
  transform: scale(0);
  transition: transform .6s ease;
}
.btn-signal:hover .signal-ripple { transform: scale(2.5); }
.btn-signal:hover {
  border-color: var(--ac-bright);
  box-shadow: 0 0 32px rgba(121,178,104,.15),
              inset 0 0 20px rgba(121,178,104,.04);
}

/* ────────────────────────────────────────────────
   ABOUT SECTION
──────────────────────────────────────────────── */
.about-section {
  background: linear-gradient(180deg, transparent, var(--bg-surface) 50%, transparent);
}

.about-card {
  max-width: 700px;
  border: 1px solid var(--bd-normal);
  padding: 32px;
  background: var(--bg-card);
  position: relative;
}
.about-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--ac-mid), transparent);
}

.card-watermark {
  position: absolute;
  top: 22px; right: 20px;
  font-family: var(--ff-display);
  font-size: 1.5rem;
  letter-spacing: .22em;
  color: var(--ac-mid);
  border: 2px solid var(--ac-mid);
  padding: 4px 10px;
  transform: rotate(-13deg);
  opacity: .4;
  pointer-events: none;
}

.about-id-block {
  display: flex;
  gap: 22px;
  margin-bottom: 26px;
  padding-bottom: 26px;
  border-bottom: 1px solid var(--bd-faint);
}

.id-photo {
  flex-shrink: 0;
  width: 80px; height: 100px;
  border: 1px solid var(--bd-normal);
  overflow: hidden;
  background: var(--bg-inset);
}
.id-photo svg { width: 100%; height: 100%; }

.id-fields { flex: 1; }
.id-field {
  display: flex;
  gap: 10px;
  padding: 4px 0;
  font-size: .77rem;
  border-bottom: 1px dotted var(--bd-faint);
}
.id-field:last-child { border-bottom: none; }
.id-field dt { color: var(--tx-muted); min-width: 140px; flex-shrink: 0; }
.id-field dd { color: var(--tx-main); }
.id-field .redacted { color: var(--red-mid); }
.id-field .status-ok { color: var(--ac-bright); }

.about-main {
  font-size: .98rem;
  color: var(--tx-bright);
  font-style: italic;
  margin-bottom: 14px;
}
.about-sub {
  font-size: .83rem;
  color: var(--tx-body);
  margin-bottom: 10px;
}

.barcode {
  margin-top: 24px;
  padding-top: 16px;
  border-top: 1px solid var(--bd-faint);
}
.barcode-bars {
  height: 30px;
  background: repeating-linear-gradient(
    90deg,
    var(--tx-ghost) 0px, var(--tx-ghost) 1px,
    transparent 1px,  transparent 3px,
    var(--tx-ghost) 3px, var(--tx-ghost) 5px,
    transparent 5px,  transparent 9px,
    var(--tx-ghost) 9px, var(--tx-ghost) 11px,
    transparent 11px, transparent 14px,
    var(--tx-ghost) 14px, var(--tx-ghost) 15px,
    transparent 15px, transparent 17px
  );
  margin-bottom: 5px;
  opacity: .55;
}
.barcode-text {
  font-size: .6rem;
  letter-spacing: .35em;
  color: var(--tx-ghost);
}

/* ────────────────────────────────────────────────
   PROJECTS SECTION
──────────────────────────────────────────────── */
.projects-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
}

.project-card {
  border: 1px solid var(--bd-normal);
  padding: 20px 18px;
  background: var(--bg-card);
  position: relative;
  overflow: hidden;
  transition: border-color var(--ease-med),
              background var(--ease-med),
              transform var(--ease-med),
              box-shadow var(--ease-med);
}
.project-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 3px; height: 0;
  background: var(--ac-bright);
  transition: height var(--ease-med);
}
.project-card:hover {
  border-color: var(--bd-bright);
  background: var(--bg-elevated);
  transform: translateY(-3px);
  box-shadow: 0 12px 32px rgba(0,0,0,.45);
}
.project-card:hover::before { height: 100%; }

.project-card--wide { grid-column: span 2; }

.proj-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
}
.proj-id { font-size: .64rem; letter-spacing: .16em; color: var(--tx-ghost); }

.proj-badge {
  font-size: .6rem;
  letter-spacing: .1em;
  padding: 2px 7px;
  border: 1px solid;
}
.badge-active     { color: var(--ac-bright); border-color: var(--ac-mid); }
.badge-pending    { color: #c5a84a; border-color: var(--amber-dim); }
.badge-classified { color: #c47070; border-color: var(--red-dim); }
.badge-unknown    { color: var(--grey-dim); border-color: var(--grey-dim); }

.proj-icon { width: 46px; height: 46px; margin-bottom: 12px; }
.proj-icon svg { width: 100%; height: 100%; }

.proj-name {
  font-family: var(--ff-display);
  font-size: 1.42rem;
  letter-spacing: .15em;
  color: var(--tx-bright);
  margin-bottom: 8px;
}
.proj-desc {
  font-size: .78rem;
  color: var(--tx-body);
  line-height: 1.65;
  margin-bottom: 16px;
}

.proj-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid var(--bd-faint);
  padding-top: 11px;
}
.proj-tag {
  font-size: .62rem;
  letter-spacing: .14em;
  color: var(--tx-muted);
  background: var(--bd-faint);
  padding: 2px 8px;
}
.proj-arrow {
  color: var(--ac-bright);
  font-size: 1.1rem;
  opacity: 0;
  transform: translateX(-8px);
  transition: opacity var(--ease-med), transform var(--ease-med);
}
.project-card:hover .proj-arrow {
  opacity: 1;
  transform: translateX(0);
}

/* ────────────────────────────────────────────────
   GALLERY SECTION
──────────────────────────────────────────────── */
.gallery-section { background: var(--bg-surface); }

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}
.gallery-item {
  border: 1px solid var(--bd-faint);
  overflow: hidden;
  cursor: pointer;
  transition: border-color var(--ease-med), transform var(--ease-med);
}
.gallery-item:hover { border-color: var(--bd-normal); transform: scale(1.01); }
.gallery-item--tall { grid-row: span 2; }
.gallery-item--wide { grid-column: span 2; }

.gallery-img { background: var(--bg-root); overflow: hidden; }
.gallery-img svg {
  width: 100%; height: auto;
  transition: filter var(--ease-med), transform var(--ease-slow);
}
.gallery-item:hover .gallery-img svg {
  filter: brightness(1.18) contrast(1.08);
  transform: scale(1.04);
}

.gallery-cap {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 7px 12px;
  background: rgba(7,11,8,.88);
  border-top: 1px solid var(--bd-faint);
}
.gallery-id-label { font-size: .64rem; color: var(--tx-muted); letter-spacing: .1em; }
.gallery-status   { font-size: .61rem; color: var(--tx-ghost); letter-spacing: .12em; }

/* ────────────────────────────────────────────────
   LOG SECTION
──────────────────────────────────────────────── */
.log-list {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.log-entry {
  border: 1px solid var(--bd-normal);
  background: var(--bg-card);
  position: relative;
  overflow: hidden;
  transition: border-color var(--ease-med);
}
.log-entry::after {
  content: '';
  position: absolute;
  top: 0; left: 0; bottom: 0;
  width: 3px;
  background: var(--ac-mid);
}
.log-entry:hover { border-color: var(--bd-bright); }

.log-head {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 11px 16px 11px 20px;
  background: var(--bg-elevated);
  border-bottom: 1px solid var(--bd-faint);
}
.log-id {
  font-family: var(--ff-display);
  font-size: 1.22rem;
  letter-spacing: .1em;
  color: var(--ac-bright);
}
.log-date { font-size: .7rem; color: var(--tx-muted); letter-spacing: .07em; flex: 1; }

.log-badge {
  font-size: .6rem;
  letter-spacing: .12em;
  padding: 2px 8px;
  border: 1px solid;
}
.badge-low  { color: var(--ac-mid);    border-color: var(--ac-dark); }
.badge-mid  { color: #c5a84a;          border-color: var(--amber-dim); }
.badge-high { color: var(--tx-bright); border-color: var(--bd-bright); }

.log-body {
  padding: 18px 18px 18px 22px;
  font-size: .87rem;
  color: var(--tx-body);
  line-height: 1.78;
}
.log-body code {
  background: var(--bg-elevated);
  border: 1px solid var(--bd-faint);
  padding: 1px 6px;
  font-size: .84em;
  color: var(--ac-bright);
}

.log-tags {
  padding: 9px 18px 9px 22px;
  border-top: 1px solid var(--bd-faint);
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.log-tag { font-size: .64rem; color: var(--tx-dim); }

/* ────────────────────────────────────────────────
   CONTACT SECTION
──────────────────────────────────────────────── */
.contact-section {
  background: linear-gradient(180deg, transparent, var(--bg-surface));
}

.contact-wrap {
  max-width: 580px;
  display: flex;
  flex-direction: column;
  gap: 28px;
}

.contact-terminal {
  border: 1px solid var(--bd-normal);
  background: var(--bg-card);
}
.ct-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 9px 16px;
  background: var(--bg-elevated);
  border-bottom: 1px solid var(--bd-faint);
  font-size: .7rem;
  letter-spacing: .1em;
}
.ct-title { color: var(--tx-muted); }
.ct-ready {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--ac-bright);
  font-size: .65rem;
}
.ct-body {
  padding: 18px 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: .82rem;
  color: var(--tx-body);
}
.ct-prompt { color: var(--ac-mid); margin-right: 6px; }

.signal-feedback {
  font-size: .78rem;
  color: var(--ac-bright);
  letter-spacing: .1em;
  min-height: 1.4em;
}

/* ────────────────────────────────────────────────
   EASTER EGG MODAL
──────────────────────────────────────────────── */
.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.82);
  z-index: 5000;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
  opacity: 0;
  transition: opacity var(--ease-med);
  pointer-events: none;
}
.modal-backdrop:not([hidden]) {
  opacity: 1;
  pointer-events: auto;
}

.modal-box {
  width: min(92%, 500px);
  border: 1px solid var(--bd-bright);
  background: var(--bg-card);
  animation: modalPop .3s ease;
}
@keyframes modalPop {
  from { transform: scale(.92) translateY(18px); opacity: 0; }
  to   { transform: scale(1)   translateY(0);    opacity: 1; }
}

.modal-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 16px;
  background: var(--bg-elevated);
  border-bottom: 1px solid var(--bd-faint);
  font-size: .7rem;
  letter-spacing: .1em;
  color: var(--tx-muted);
}
.modal-close {
  background: none;
  border: none;
  color: var(--tx-muted);
  cursor: pointer;
  font-size: 1.2rem;
  line-height: 1;
  transition: color var(--ease-fast);
}
.modal-close:hover { color: var(--tx-bright); }

.modal-body {
  padding: 30px 28px;
  text-align: center;
  position: relative;
}
.modal-watermark {
  position: absolute;
  top: 18px; right: 22px;
  font-family: var(--ff-display);
  font-size: 1.7rem;
  letter-spacing: .16em;
  color: var(--ac-mid);
  border: 2px solid var(--ac-mid);
  padding: 3px 10px;
  transform: rotate(-9deg);
  opacity: .45;
  pointer-events: none;
}
.modal-title {
  font-family: var(--ff-display);
  font-size: 2.2rem;
  letter-spacing: .2em;
  color: var(--tx-bright);
  margin-bottom: 14px;
}
.modal-msg {
  font-size: .95rem;
  color: var(--ac-bright);
  margin-bottom: 12px;
  letter-spacing: .04em;
}
.modal-sub {
  font-size: .8rem;
  color: var(--tx-body);
  margin-bottom: 24px;
  line-height: 1.7;
}

.modal-log {
  background: var(--bg-inset);
  border: 1px solid var(--bd-faint);
  padding: 14px 16px;
  text-align: left;
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: .74rem;
  color: var(--ac-bright);
}
.mlog-line { opacity: 0; transition: opacity .3s ease; }
.mlog-line.visible { opacity: 1; }

/* ────────────────────────────────────────────────
   FOOTER
──────────────────────────────────────────────── */
.site-footer {
  border-top: 1px solid var(--bd-faint);
  padding: 20px 24px;
}
.footer-inner {
  max-width: var(--max-w);
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  font-size: .68rem;
  letter-spacing: .1em;
  color: var(--tx-ghost);
}
.footer-status {
  display: flex;
  align-items: center;
  gap: 7px;
  color: var(--tx-dim);
}

/* ────────────────────────────────────────────────
   SCROLL REVEAL
──────────────────────────────────────────────── */
.reveal {
  opacity: 0;
  transform: translateY(22px);
  transition: opacity .6s ease, transform .6s ease;
}
.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

/* ────────────────────────────────────────────────
   RESPONSIVE — TABLET
──────────────────────────────────────────────── */
@media (max-width: 920px) {
  .projects-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .project-card--wide {
    grid-column: span 2;
  }
  .gallery-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .gallery-item--tall { grid-row: span 1; }
}

/* ────────────────────────────────────────────────
   RESPONSIVE — MOBILE
──────────────────────────────────────────────── */
@media (max-width: 640px) {
  /* Nav becomes drawer */
  .nav-links {
    position: fixed;
    top: var(--nav-total);
    left: 0; right: 0;
    background: rgba(7,11,8,.98);
    border-bottom: 1px solid var(--bd-normal);
    flex-direction: column;
    padding: 14px 24px;
    gap: 4px;
    z-index: 1098;
    transform: translateY(-120%);
    transition: transform var(--ease-med);
  }
  .nav-links.open { transform: translateY(0); }
  .nav-toggle { display: flex; }

  /* Disable custom cursor on touch */
  body { cursor: auto; }
  .cursor { display: none; }

  /* Hero adjustments */
  .hero-title {
    font-size: clamp(2rem, 11vw, 3.2rem);
    letter-spacing: .12em;
  }
  .file-meta-row {
    flex-direction: column;
    gap: 2px;
  }
  .file-stamp-banner { font-size: .82rem; }

  /* Projects — single column */
  .projects-grid {
    grid-template-columns: 1fr;
  }
  .project-card--wide { grid-column: span 1; }

  /* Gallery — single column */
  .gallery-grid {
    grid-template-columns: 1fr;
  }
  .gallery-item--wide { grid-column: span 1; }

  /* About */
  .about-id-block {
    flex-direction: column;
    align-items: flex-start;
  }

  /* Log header wraps */
  .log-head { flex-wrap: wrap; }

  /* Hide file-id in status bar to save space */
  .status-fileid { display: none; }

  .section { padding: 72px 0; }
  .section-header { margin-bottom: 36px; }
}

/* Touch devices — restore cursor */
@media (hover: none) {
  body { cursor: auto; }
  .cursor { display: none !important; }
}
